{
  /* Envio V3 template settings (ESM, bundler resolution), plus .ts import specifiers. */
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2023",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "lib": ["es2023"],
    "types": ["node"]
  },
  "include": ["src", "test", "envio-env.d.ts", "vitest.config.ts", "vitest.live.config.ts"]
}
